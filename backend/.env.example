# ── Banco de dados ──────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/agendix"

# ── Auth ────────────────────────────────────────────────────────────────────────
# Gerar com: openssl rand -hex 64
JWT_SECRET=SUBSTITUA_POR_STRING_ALEATORIA_DE_64_BYTES

# Chave de criptografia AES-256 para campos sensíveis no banco (evolutionApiKey, smtpPass, etc.)
# Gerar com: openssl rand -hex 32
ENCRYPTION_KEY=SUBSTITUA_POR_64_CHARS_HEX
JWT_EXPIRES_IN=7d
PORT=3000

# Token mestre para endpoints de lembrete global (n8n cross-tenant)
# Gerar com: openssl rand -hex 32
MASTER_API_TOKEN=SUBSTITUA_POR_TOKEN_ALEATORIO

# ── App URL ─────────────────────────────────────────────────────────────────────
APP_URL=https://app.seudominio.com.br

# Origens permitidas para CORS (separadas por vírgula)
ALLOWED_ORIGINS=https://app.seudominio.com.br,https://admin.seudominio.com.br

# ── Email SMTP ──────────────────────────────────────────────────────────────────
SMTP_HOST=smtp.seuservidor.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=email@seudominio.com
SMTP_PASS=SUBSTITUA_PELA_SENHA_SMTP
SMTP_FROM=email@seudominio.com

# ── Evolution API (WhatsApp) ─────────────────────────────────────────────────────
EVOLUTION_BASE_URL=https://evolution.seudominio.com
EVOLUTION_GLOBAL_API_KEY=SUBSTITUA_PELA_CHAVE_EVOLUTION

# ── n8n ─────────────────────────────────────────────────────────────────────────
N8N_BASE_URL=https://n8n.seudominio.com
N8N_API_KEY=SUBSTITUA_PELA_CHAVE_N8N

# ── Mercado Pago ─────────────────────────────────────────────────────────────────
# Produção: obter em https://www.mercadopago.com.br/developers/panel
MP_ACCESS_TOKEN=SUBSTITUA_PELO_ACCESS_TOKEN_MP
# Gerar com: openssl rand -hex 32
MP_WEBHOOK_SECRET=SUBSTITUA_PELO_WEBHOOK_SECRET_MP
MP_PLAN_BASICO_ID=SUBSTITUA_PELO_ID_DO_PLANO_BASICO
MP_PLAN_PRO_ID=SUBSTITUA_PELO_ID_DO_PLANO_PRO
MP_PLAN_PREMIUM_ID=SUBSTITUA_PELO_ID_DO_PLANO_PREMIUM
MP_PLAN_BUSINESS_ID=SUBSTITUA_PELO_ID_DO_PLANO_BUSINESS
