generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Tenant (empresa compradora) ────────────────────────────────────────────
model Tenant {
  id          Int           @id @default(autoincrement())
  nome        String
  slug        String        @unique
  logo        String?
  corPrimaria String        @default("#2563eb") @map("cor_primaria")
  plano       Plano         @default(solo)
  modulos     Json          @default("[\"leads\",\"agendamentos\"]")
  ativo           Boolean  @default(true)
  n8nWebhookUrl   String?  @map("n8n_webhook_url")
  n8nApiKey       String?  @map("n8n_api_key")
  apiToken        String?  @unique @map("api_token")
  nichoLabel        String?  @map("nicho_label")
  subnicho          String?  @map("subnicho")
  evolutionInstance String?  @map("evolution_instance")
  evolutionApiKey   String?  @map("evolution_api_key")
  evolutionBaseUrl  String?  @map("evolution_base_url")
  waProvider        String   @default("evolution") @map("wa_provider")
  waConfig          String?  @map("wa_config")
  planoStatus       String   @default("trial") @map("plano_status")
  planoVencimento   DateTime? @map("plano_vencimento")
  mpCustomerId          String?  @map("mp_customer_id")
  mpSubscriptionId      String?  @map("mp_subscription_id")
  mpPlanId              String?  @map("mp_plan_id")
  n8nWorkflowWaId       String?  @map("n8n_workflow_wa_id")
  n8nWorkflowNotifId    String?  @map("n8n_workflow_notif_id")
  lembretesDiretosAtivo  Boolean  @default(false) @map("lembretes_diretos_ativo")
  n8nAtivo               Boolean  @default(false) @map("n8n_ativo")
  whatsappResponsavel    String?  @map("whatsapp_responsavel")
  smtpHost   String?  @map("smtp_host")
  smtpPort   Int?     @map("smtp_port")
  smtpUser   String?  @map("smtp_user")
  smtpPass   String?  @map("smtp_pass")
  smtpFrom   String?  @map("smtp_from")
  trialEmailD3EnviadoEm  DateTime? @map("trial_email_d3_enviado_em")
  trialEmailD10EnviadoEm DateTime? @map("trial_email_d10_enviado_em")
  trialEmailD13EnviadoEm DateTime? @map("trial_email_d13_enviado_em")
  planoDowngradePendente  Plano?    @map("plano_downgrade_pendente")
  planoDowngradeData      DateTime? @map("plano_downgrade_data")
  cicloBilhagem           String    @default("mensal") @map("ciclo_bilhagem")
  renovacaoEmailEnviadoEm DateTime? @map("renovacao_email_enviado_em")
  // Dados de contato e legais
  email          String?
  telefone       String?
  cnpj           String?
  razaoSocial    String?  @map("razao_social")
  logradouro     String?
  numero         String?
  complemento    String?
  bairro         String?
  cidade         String?
  estado         String?
  cep            String?
  cadastroCompleto Boolean @default(false) @map("cadastro_completo")
  webhookSecret    String? @map("webhook_secret")
  createdAt              DateTime @default(now()) @map("created_at")

  users              User[]
  leads              Lead[]
  agendamentos       Agendamento[]
  configuracaoAgenda ConfiguracaoAgenda?
  conversasWhatsapp  ConversaWhatsapp[]
  servicos           Servico[]
  bloqueios          BloqueioHorario[]
  lancamentos        LancamentoFinanceiro[]
  notificacoes       Notificacao[]
  adminLancamentos   AdminLancamento[]
  backups            Backup[]
  agentConfig        AgentConfig?
  agentSessions      AgentSession[]
  agentLeads         AgentLead[]
  pushSubscriptions  PushSubscription[]
  waAtendentes       WaAtendente[]
  waFilas            WaFila[]
  fichas             FichaCliente[]
  anamneses          Anamnese[]
  orcamentos         Orcamento[]
  ordensServico      OrdemServico[]
  prontuarios        Prontuario[]
  documentos         Documento[]
  processos          Processo[]
  leadAtividades     LeadAtividade[]
  mensagemLogs       MensagemLog[]
  @@map("tenants")
}

// ─── User ────────────────────────────────────────────────────────────────────
model User {
  id        Int      @id @default(autoincrement())
  tenantId  Int?     @map("tenant_id")
  tenant    Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  nome      String
  email     String
  senha     String
  role                 Role     @default(atendente)
  ativo                Boolean  @default(true)
  whatsapp             String?
  createdAt            DateTime @default(now()) @map("created_at")
  passwordResetToken   String?  @map("password_reset_token")
  passwordResetExpires DateTime? @map("password_reset_expires")
  activationToken      String?  @map("activation_token")
  activationExpires    DateTime? @map("activation_expires")
  totpSecret           String?  @map("totp_secret")
  totpAtivo            Boolean  @default(false) @map("totp_ativo")

  pushSubscriptions  PushSubscription[]
  atividades         LeadAtividade[]
  permissions        UserPermission[]

  @@unique([email, tenantId])
  @@map("users")
}

// ─── SecurityIncident (SIEM Sprint 4) ────────────────────────────────────────
model SecurityIncident {
  id           Int       @id @default(autoincrement())
  tipo         String
  severidade   String    @default("medium")
  ip           String?
  tenantId     Int?      @map("tenant_id")
  userId       Int?      @map("user_id")
  detalhes     Json?
  status       String    @default("open")
  resolvidoPor String?   @map("resolvido_por")
  criadoEm    DateTime  @default(now()) @map("criado_em")
  resolvidoEm  DateTime? @map("resolvido_em")

  @@map("security_incidents")
}

// ─── UserPermission (RBAC granular) ──────────────────────────────────────────
model UserPermission {
  id       Int     @id @default(autoincrement())
  userId   Int     @map("user_id")
  resource String
  action   String
  granted  Boolean @default(true)
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, resource, action], name: "userId_resource_action")
  @@map("user_permissions")
}

// ─── Lead ────────────────────────────────────────────────────────────────────
model Lead {
  id          Int        @id @default(autoincrement())
  tenantId    Int        @map("tenant_id")
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Dados básicos
  nome        String
  telefone    String?
  telefone2   String?    @map("telefone2")
  email       String?
  origem      String?
  status      StatusLead @default(novo)
  priority    Priority   @default(normal)
  observacoes String?
  fonte       Fonte      @default(manual)

  // Endereço completo
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  municipio   String?
  estado      String?

  // Dados Google Maps
  nicho         String?
  categoria     String?
  subcategoria  String?
  googleMapsUrl String?  @map("google_maps_url")
  placeId       String?  @map("place_id")
  rating        Float?
  reviewsCount  Int?     @default(0) @map("reviews_count")
  website       String?

  // Redes sociais
  facebook      String?
  instagram     String?
  telegram      String?
  especialidades String?

  // Disparo
  disparo       String?
  disparoCiclo  Int     @default(0) @map("disparo_ciclo")
  respondeuWa   Boolean @default(false) @map("respondeu_wa")
  mensagem      String?
  respostaWa    String? @map("resposta_wa")

  // Cliente (pós-conversão)
  servicosContratados Json    @default("[]") @map("servicos_contratados")
  clienteStatus       String? @default("ativo") @map("cliente_status")

  // Funil
  ultimoContato  DateTime? @map("ultimo_contato")
  proximoContato DateTime? @map("proximo_contato")

  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  agendamentos Agendamento[]
  lancamentos  LancamentoFinanceiro[]
  fichas       FichaCliente[]
  anamneses    Anamnese[]
  orcamentos    Orcamento[]
  ordensServico OrdemServico[]
  prontuarios   Prontuario[]
  documentos    Documento[]
  processos     Processo[]
  atividades    LeadAtividade[]
  mensagemLogs  MensagemLog[]

  @@unique([placeId, tenantId])
  @@index([tenantId, status])
  @@index([tenantId, createdAt])
  @@index([tenantId, telefone])
  @@index([tenantId, email])
  @@index([nicho])
  @@index([estado])
  @@index([municipio])
  @@index([fonte])
  @@map("leads")
}

// ─── Agendamento ─────────────────────────────────────────────────────────────
model Agendamento {
  id          Int         @id @default(autoincrement())
  tenantId    Int         @map("tenant_id")
  tenant      Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId      Int         @map("lead_id")
  lead        Lead        @relation(fields: [leadId], references: [id], onDelete: Cascade)
  servicoId   Int?        @map("servico_id")
  servico     Servico?    @relation(fields: [servicoId], references: [id], onDelete: SetNull)
  data        String
  hora        String
  tipo        String?     @default("reunião")
  status      StatusAgend @default(marcado)
  observacoes String?
  // Campos dual-canal
  canalOrigem     CanalOrigem @default(manual) @map("canal_origem")
  clienteNome     String?     @map("cliente_nome")
  clienteTelefone String?     @map("cliente_telefone")
  lembreteEnviado    Boolean @default(false) @map("lembrete_enviado")
  lembrete3dEnviado  Boolean @default(false) @map("lembrete_3d_enviado")
  lembrete1dEnviado  Boolean @default(false) @map("lembrete_1d_enviado")
  lembreteDiaEnviado Boolean @default(false) @map("lembrete_dia_enviado")
  cancelToken        String? @unique @map("cancel_token")
  recorrenciaId      String? @map("recorrencia_id")
  recorrenciaTipo    String? @map("recorrencia_tipo") // semanal | mensal
  createdAt   DateTime    @default(now()) @map("created_at")
  updatedAt   DateTime    @updatedAt @map("updated_at")

  @@index([tenantId, data])
  @@index([tenantId, status])
  @@index([data, status])
  @@index([lembreteEnviado, status])
  @@index([leadId])
  @@map("agendamentos")
}

// ─── Servico (por tenant) ─────────────────────────────────────────────────────
model Servico {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome        String
  descricao   String?
  duracaoMin  Int      @default(60) @map("duracao_min")
  preco       Decimal? @db.Decimal(10, 2)
  ativo       Boolean  @default(true)
  ordem       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  agendamentos Agendamento[]
  lancamentos  LancamentoFinanceiro[]

  @@map("servicos")
}

// ─── BloqueioHorario (por tenant) ────────────────────────────────────────────
model BloqueioHorario {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  data        String
  horaInicio  String?  @map("hora_inicio")
  horaFim     String?  @map("hora_fim")
  motivo      String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([tenantId, data])
  @@map("bloqueios_horario")
}

// ─── ConfiguracaoAgenda (por tenant) ─────────────────────────────────────────
model ConfiguracaoAgenda {
  id              Int     @id @default(autoincrement())
  tenantId        Int     @unique @map("tenant_id")
  tenant          Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  horarioInicio   String  @default("08:00") @map("horario_inicio")
  horarioFim      String  @default("18:00") @map("horario_fim")
  duracaoSlot     Int     @default(60) @map("duracao_slot")
  diasUteis       String  @default("1,2,3,4,5") @map("dias_uteis")
  antecedenciaMin Int     @default(2) @map("antecedencia_min")
  antecedenciaMax Int     @default(30) @map("antecedencia_max")
  mensagemConfirmacao   String? @map("mensagem_confirmacao")
  mensagemWaConfirmacao String? @map("mensagem_wa_confirmacao")
  mensagemWaLembrete    String? @map("mensagem_wa_lembrete")
  mensagemWaAdmin       String? @map("mensagem_wa_admin")
  whatsappAdmin   String? @map("whatsapp_admin")
  ativo           Boolean @default(true)
  agendaDiaAtivo      Boolean  @default(false) @map("agenda_dia_ativo")
  agendaDiaEmailAtivo Boolean  @default(false) @map("agenda_dia_email_ativo")
  agendaDiaHorario    String   @default("07:00") @map("agenda_dia_horario")
  agendaDiaEnviadoEm  String?  @map("agenda_dia_enviado_em")

  @@map("configuracoes_agenda")
}

// ─── ConversaWhatsapp (estado da conversa em andamento) ──────────────────────
model ConversaWhatsapp {
  id        Int             @id @default(autoincrement())
  tenantId  Int             @map("tenant_id")
  tenant    Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  telefone  String
  estado    EstadoConversa  @default(inicio)
  dadosJson Json?           @map("dados_json")
  expiresAt DateTime        @map("expires_at")
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@unique([telefone, tenantId])
  @@index([tenantId, expiresAt])
  @@map("conversas_whatsapp")
}

// ─── Enums ───────────────────────────────────────────────────────────────────
enum Plano {
  solo
  pro
  business
}

enum Role {
  super_admin
  admin
  atendente
}

enum StatusLead {
  novo
  contato
  qualificado
  proposta
  agendado
  convertido
  perdido
}

enum Priority {
  baixa
  normal
  alta
  urgente
}

enum Fonte {
  google_maps
  manual
  csv_import
  api
}

enum StatusAgend {
  marcado
  confirmado
  cancelado
  realizado
}

enum CanalOrigem {
  manual
  web
  whatsapp
}

// ─── LancamentoFinanceiro ─────────────────────────────────────────────────────
model LancamentoFinanceiro {
  id            Int             @id @default(autoincrement())
  tenantId      Int             @map("tenant_id")
  tenant        Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipo          TipoLancamento
  descricao     String
  valor         Decimal         @db.Decimal(10, 2)
  data          String
  categoria     String?
  status        StatusPagamento @default(pendente)
  leadId        Int?            @map("lead_id")
  lead          Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  servicoId     Int?            @map("servico_id")
  servico       Servico?        @relation(fields: [servicoId], references: [id], onDelete: SetNull)
  observacoes   String?
  createdAt     DateTime        @default(now()) @map("created_at")
  updatedAt     DateTime        @updatedAt @map("updated_at")

  @@index([tenantId, data])
  @@index([tenantId, tipo])
  @@index([tenantId, status])
  @@map("lancamentos_financeiros")
}

enum TipoLancamento {
  receita
  despesa
}

enum StatusPagamento {
  pago
  pendente
  cancelado
}

// ─── Notificacao (in-app, por tenant) ────────────────────────────────────────
model Notificacao {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  tipo      String   // lembrete_enviado, lembrete_falhou, agendamento_hoje
  titulo    String
  corpo     String?
  lida      Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")

  @@index([tenantId, lida])
  @@map("notificacoes")
}

enum EstadoConversa {
  inicio
  aguardando_data
  aguardando_slot
  aguardando_nome
  aguardando_confirmacao
  concluida
  cancelada
}

// ─── AdminLancamento (financeiro da plataforma SaaS) ─────────────────────────
model AdminLancamento {
  id          Int             @id @default(autoincrement())
  tipo        TipoLancamento
  descricao   String
  valor       Decimal         @db.Decimal(10, 2)
  data        String
  categoria   String?
  status      StatusPagamento @default(pago)
  tenantId    Int?            @map("tenant_id")
  tenant      Tenant?         @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  referencia  String?
  observacoes String?
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([data])
  @@index([tipo])
  @@map("admin_lancamentos")
}

// ─── Backup (histórico de backups admin e tenant) ─────────────────────────────
model Backup {
  id           Int      @id @default(autoincrement())
  tipo         String
  tenantId     Int?     @map("tenant_id")
  tenant       Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  nomeArquivo  String   @map("nome_arquivo")
  tamanhoBytes Int?     @map("tamanho_bytes")
  descricao    String?
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([tipo])
  @@map("backups")
}

// ─── AgentConfig (configuração do Agente IA por tenant) ──────────────────────
model AgentConfig {
  id              Int      @id @default(autoincrement())
  tenantId        Int      @unique @map("tenant_id")
  tenant          Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  ativo           Boolean  @default(false)
  persona         String   @default("Assistente")
  promptBase      String   @db.Text
  horarioInicio   String   @default("09:00") @map("horario_inicio")
  horarioFim      String   @default("18:00") @map("horario_fim")
  diasUteis       String   @default("1,2,3,4,5") @map("dias_uteis")
  msgForaHorario  String?  @db.Text @map("msg_fora_horario")
  checkoutUrl     String?  @map("checkout_url")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("agent_configs")
}

// ─── AgentSession (sessão de conversa do agente por telefone) ─────────────────
model AgentSession {
  id           String   @id // telefone
  tenantId     Int      @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  messagesJson Json     @map("messages_json")
  lastActivity DateTime @map("last_activity")
  createdAt    DateTime @default(now()) @map("created_at")

  @@unique([id, tenantId])
  @@map("agent_sessions")
}

// ─── AgentLead (leads captados pelo agente IA) ────────────────────────────────
model AgentLead {
  id           Int      @id @default(autoincrement())
  tenantId     Int      @map("tenant_id")
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  telefone     String
  nome         String?
  primeiraMsg  String?  @db.Text @map("primeira_msg")
  sentCheckout Boolean  @default(false) @map("sent_checkout")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@unique([tenantId, telefone])
  @@index([tenantId])
  @@map("agent_leads")
}

// ─── PushSubscription (Web Push VAPID por usuário) ───────────────────────────
model PushSubscription {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  userId    Int      @map("user_id")
  endpoint  String   @db.Text
  p256dh    String
  auth      String
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, endpoint])
  @@index([tenantId])
  @@map("push_subscriptions")
}

// ─── WaAtendente (atendentes humanos de WhatsApp por tenant) ─────────────────
model WaAtendente {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  nome        String
  telefone    String   // número do atendente (para notificação)
  ativo       Boolean  @default(true)
  cargaAtual  Int      @default(0) @map("carga_atual")
  cargaMaxima Int      @default(5) @map("carga_maxima")
  createdAt   DateTime @default(now()) @map("created_at")

  filas       WaFila[]

  @@index([tenantId, ativo])
  @@map("wa_atendentes")
}

// ─── WaFila (sessão de atendimento humano) ────────────────────────────────────
model WaFila {
  id              Int          @id @default(autoincrement())
  tenantId        Int          @map("tenant_id")
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clienteTelefone String       @map("cliente_telefone")
  clienteNome     String?      @map("cliente_nome")
  atendenteId     Int?         @map("atendente_id")
  atendente       WaAtendente? @relation(fields: [atendenteId], references: [id], onDelete: SetNull)
  status          StatusFila   @default(aguardando)
  abertaEm        DateTime     @default(now()) @map("aberta_em")
  fechadaEm       DateTime?    @map("fechada_em")

  logs            WaConversaLog[]

  @@index([tenantId, status])
  @@index([tenantId, abertaEm])
  @@map("wa_filas")
}

// ─── WaConversaLog (auditoria imutável de mensagens) ─────────────────────────
model WaConversaLog {
  id          Int             @id @default(autoincrement())
  filaId      Int             @map("fila_id")
  fila        WaFila          @relation(fields: [filaId], references: [id], onDelete: Cascade)
  tenantId    Int             @map("tenant_id")
  direcao     DirecaoMsg
  deTelefone  String          @map("de_telefone")
  paraTelefone String         @map("para_telefone")
  mensagem    String          @db.Text
  atendenteId Int?            @map("atendente_id")   // null = bot
  fonte       FonteMsg        @default(bot)
  criadoEm   DateTime         @default(now()) @map("criado_em")

  @@index([filaId])
  @@index([tenantId, criadoEm])
  @@map("wa_conversa_logs")
}

enum StatusFila {
  aguardando
  em_atendimento
  encerrado
  abandonado
}

enum DirecaoMsg {
  entrada
  saida
}

enum FonteMsg {
  bot
  humano
  gemini
}

// ─── Orcamento (orçamento de serviço por nicho) ───────────────────────────────
model Orcamento {
  id          Int             @id @default(autoincrement())
  tenantId    Int             @map("tenant_id")
  tenant      Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId      Int?            @map("lead_id")
  lead        Lead?           @relation(fields: [leadId], references: [id], onDelete: SetNull)
  numero      String          // ex: "ORC-2026-001"
  clienteNome String          @map("cliente_nome")
  clienteTel  String?         @map("cliente_tel")
  descricao   String?         @db.Text
  itens       Json            @default("[]") // [{descricao, qtd, valorUnit}]
  valorTotal  Decimal         @default(0) @db.Decimal(10,2) @map("valor_total")
  status      StatusOrcamento @default(rascunho)
  validadeAte String?         @map("validade_ate") // data YYYY-MM-DD
  observacoes String?         @db.Text
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@map("orcamentos")
}

enum StatusOrcamento {
  rascunho
  enviado
  aprovado
  recusado
  expirado
}

// ─── FichaCliente (ficha cadastral por nicho) ─────────────────────────────────
model FichaCliente {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId      Int?     @map("lead_id")
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)
  nome        String
  telefone    String?
  email       String?
  campos      Json     @default("{}") // campos específicos por nicho
  observacoes String?  @db.Text
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  anamneses   Anamnese[]

  @@index([tenantId, createdAt])
  @@index([tenantId, leadId])
  @@map("fichas_clientes")
}

// ─── Anamnese (questionário clínico/estético/físico por nicho) ────────────────
model Anamnese {
  id          Int           @id @default(autoincrement())
  tenantId    Int           @map("tenant_id")
  tenant      Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  fichaId     Int?          @map("ficha_id")
  ficha       FichaCliente? @relation(fields: [fichaId], references: [id], onDelete: SetNull)
  leadId      Int?          @map("lead_id")
  lead        Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)
  nomeCliente String        @map("nome_cliente")
  campos      Json          @default("{}") // campos específicos por nicho
  observacoes String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  @@index([tenantId, createdAt])
  @@index([tenantId, fichaId])
  @@map("anamneses")
}

// ─── Prontuario (histórico clínico evolutivo — Saúde) ────────────────────────
model Prontuario {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId      Int?     @map("lead_id")
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  // Dados do paciente
  nomeCliente  String   @map("nome_cliente")
  telefone     String?
  email        String?
  dataNascimento String? @map("data_nascimento")
  convenio     String?
  numeroCarteirinha String? @map("numero_carteirinha")

  // Campos extras dinâmicos por subnicho
  campos       Json     @default("{}")

  // Histórico de evoluções: [{data, texto, profissional}]
  evolucoes    Json     @default("[]")

  // Diagnóstico e conduta
  diagnostico  String?  @db.Text
  observacoes  String?  @db.Text

  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@index([tenantId, createdAt])
  @@index([tenantId, leadId])
  @@map("prontuarios")
}

// ─── Documento (contratos, propostas, documentos jurídicos — Serviços Profissionais) ─
model Documento {
  id          Int      @id @default(autoincrement())
  tenantId    Int      @map("tenant_id")
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId      Int?     @map("lead_id")
  lead        Lead?    @relation(fields: [leadId], references: [id], onDelete: SetNull)

  titulo      String
  tipo        String   @default("contrato") // contrato | proposta | procuracao | relatorio | outro
  clienteNome String   @map("cliente_nome")
  clienteTel  String?  @map("cliente_tel")
  conteudo    String?  @db.Text
  observacoes String?  @db.Text
  status      StatusDocumento @default(rascunho)
  dataVencimento String? @map("data_vencimento")
  arquivo     String?  // URL/path do arquivo enviado (opcional)

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@map("documentos")
}

enum StatusDocumento {
  rascunho
  ativo
  vencido
  cancelado
}

// ─── LeadAtividade ────────────────────────────────────────────────────────────
model LeadAtividade {
  id        Int      @id @default(autoincrement())
  tenantId  Int      @map("tenant_id")
  leadId    Int      @map("lead_id")
  userId    Int?     @map("user_id")
  tipo      String   // ligacao | whatsapp | email | visita | observacao
  descricao String?
  data      DateTime @default(now())
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([leadId])
  @@index([tenantId])
  @@map("lead_atividades")
}

// ─── MensagemLog (auditoria completa de envios email/whatsapp) ───────────────
model MensagemLog {
  id        Int         @id @default(autoincrement())
  tenantId  Int?        @map("tenant_id")
  tenant    Tenant?     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId    Int?        @map("lead_id")
  lead      Lead?       @relation(fields: [leadId], references: [id], onDelete: SetNull)
  meio      MeioEnvio
  status    StatusEnvio @default(enviado)
  para      String
  assunto   String?
  corpo     String      @db.Text
  origem    String      @default("manual")
  erroMsg   String?     @map("erro_msg")
  usuarioId Int?        @map("usuario_id")
  criadoEm  DateTime    @default(now()) @map("criado_em")

  @@index([tenantId])
  @@index([leadId])
  @@index([criadoEm(sort: Desc)])
  @@index([meio])
  @@index([origem])
  @@map("mensagem_logs")
}

enum MeioEnvio {
  email
  whatsapp
}

enum StatusEnvio {
  enviado
  erro
  pendente
}

// ─── OrdemServico (OS para nichos residencial, automotivo, técnico) ──────────
model OrdemServico {
  id               Int                @id @default(autoincrement())
  tenantId         Int                @map("tenant_id")
  tenant           Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId           Int?               @map("lead_id")
  lead             Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  numero           String             // ex: "OS-2026-0001"
  clienteNome      String             @map("cliente_nome")
  clienteTel       String?            @map("cliente_tel")
  clienteEndereco  String?            @map("cliente_endereco") @db.Text
  descricaoServico String?            @map("descricao_servico") @db.Text
  itens            Json               @default("[]") // [{descricao, qtd, valorUnit}]
  valorTotal       Decimal            @default(0) @db.Decimal(10,2) @map("valor_total")
  status           StatusOrdemServico @default(aberta)
  dataAbertura     String?            @map("data_abertura")   // YYYY-MM-DD
  dataPrevista     String?            @map("data_prevista")   // YYYY-MM-DD
  dataConclusao    String?            @map("data_conclusao")  // YYYY-MM-DD
  tecnicoNome      String?            @map("tecnico_nome")
  garantiaDias     Int?               @map("garantia_dias")
  observacoes      String?            @db.Text
  createdAt        DateTime           @default(now()) @map("created_at")
  updatedAt        DateTime           @updatedAt @map("updated_at")

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@map("ordens_servico")
}

enum StatusOrdemServico {
  aberta
  em_andamento
  aguardando_peca
  concluida
  cancelada
}

// ─── Processo (módulo jurídico — Serviços Profissionais) ─────────────────────
model Processo {
  id          Int            @id @default(autoincrement())
  tenantId    Int            @map("tenant_id")
  tenant      Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  leadId      Int?           @map("lead_id")
  lead        Lead?          @relation(fields: [leadId], references: [id], onDelete: SetNull)

  numero      String         // PROC-YYYY-NNNN (auto)
  titulo      String
  tipo        String         @default("outro") // acao_civil | trabalhista | criminal | familia | previdenciario | consumidor | outro
  status      StatusProcesso @default(ativo)

  vara        String?
  comarca     String?
  clienteNome String         @map("cliente_nome")
  clienteTel  String?        @map("cliente_tel")
  parteContraria String?     @map("parte_contraria")
  advogado    String?

  dataAbertura       String?  @map("data_abertura")
  prazoProximo       String?  @map("prazo_proximo")
  dataEncerramento   String?  @map("data_encerramento")

  valorCausa  Float?         @map("valor_causa")
  honorarios  Float?

  observacoes    String?   @db.Text
  movimentacoes  Json      @default("[]")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([tenantId, createdAt])
  @@index([tenantId, status])
  @@map("processos")
}

enum StatusProcesso {
  ativo
  suspenso
  encerrado
  arquivado
}

// ─── AuditLog (registro de ações críticas) ────────────────────────────────────
model AuditLog {
  id         Int      @id @default(autoincrement())
  acao       String
  entidade   String?
  entidadeId String?  @map("entidade_id")
  tenantId   Int?     @map("tenant_id")
  userId     Int?     @map("user_id")
  ip         String?
  detalhes   Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([tenantId])
  @@index([acao])
  @@map("audit_logs")
}
