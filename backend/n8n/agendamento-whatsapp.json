      "parameters": {
        "jsCode": "const { texto, dados, phone } = $json;\nconst slots = dados.slots || [];\nlet slotEscolhido = '';\nconst num = parseInt(texto);\nif (!isNaN(num) && num >= 1 && num <= slots.length) {\n  slotEscolhido = slots[num-1];\n} else if (/^\\d{1,2}:\\d{2}$/.test(texto)) {\n  slotEscolhido = slots.includes(texto) ? texto : '';\n}\nreturn [{ json: { ...dados, phone, slotEscolhido, acao: slotEscolhido ? 'confirmar_slot' : 'pedir_slot_novamente' } }];"
