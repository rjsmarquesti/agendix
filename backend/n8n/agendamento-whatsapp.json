      "parameters": {
        "jsCode": "const { texto, dados, phone } = $json;\nlet dataISO = '';\nconst hoje = new Date();\nif (/amanh[aÃ£]/i.test(texto)) {\n  const d = new Date(hoje); d.setDate(d.getDate()+1);\n  dataISO = d.toISOString().split('T')[0];\n} else {\n  const m = texto.match(/(\\d{1,2})[\\/\\-](\\d{1,2})(?:[\\/\\-](\\d{2,4}))?/);\n  if (m) {\n    const dia = m[1].padStart(2,'0');\n    const mes = m[2].padStart(2,'0');\n    const ano = m[3] ? (m[3].length===2?'20'+m[3]:m[3]) : hoje.getFullYear().toString();\n    dataISO = `${ano}-${mes}-${dia}`;\n  }\n}\nreturn [{ json: { ...dados, phone, dataISO, acao: dataISO ? 'buscar_slots' : 'pedir_data_novamente' } }];"
